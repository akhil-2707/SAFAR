# S.A.F.A.R. Environment Configuration
PORT=5000

# Payment Mode: 'demo' or 'razorpay'
# The application runs 100% in 'demo' mode without any credentials required.
PAYMENT_MODE=demo

# Future Razorpay Credentials (Leave blank in demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional MongoDB Atlas URI (Falls back to in-memory store if blank)
MONGO_URI=
JWT_SECRET=safar_super_secret_jwt_key_2026

# ========================================================
# S.A.F.A.R. GLOBAL MULTILINGUAL TRANSLATION PROVIDERS
# ========================================================
# 1. BHASHINI (Govt of India ULCA / Anuvaad for Indian Languages)
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# 2. Google Cloud Translation (Cloud Translation Advanced / v3 for Global & Fallback)
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
